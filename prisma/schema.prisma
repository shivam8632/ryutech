generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Contact {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  company   String?
  service   String?
  budget    String?
  message   String
  createdAt DateTime @default(now())
  read      Boolean  @default(false)
}

model Newsletter {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  createdAt DateTime @default(now())
  active    Boolean  @default(true)
}
